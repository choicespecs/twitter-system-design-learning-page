---
import { getCollection } from "astro:content";
import { CATEGORY_META, type Category } from "../lib/categories";
import { withBase } from "../lib/url";

const subsystems = await getCollection("subsystems");
const currentPath = Astro.url.pathname.replace(/\/$/, "");

const grouped = (Object.keys(CATEGORY_META) as Category[]).map((category) => ({
  category,
  meta: CATEGORY_META[category],
  items: subsystems
    .filter((s) => s.data.category === category)
    .sort((a, b) => a.data.order - b.data.order),
}));
---

<nav class="sidebar" aria-label="Subsystems">
  {
    grouped.map(({ category, meta, items }) =>
      items.length > 0 ? (
        <div class="group">
          <p class="group-label" style={`color: ${meta.color}`}>
            {meta.label}
          </p>
          <ul>
            {items.map((item) => {
              const href = withBase(`/subsystems/${item.id}`);
              const active = currentPath === href;
              return (
                <li>
                  <a
                    href={href}
                    class="link"
                    aria-current={active ? "page" : undefined}
                    style={active ? `--dot-color: ${meta.color}; --dot-glow: ${meta.glow};` : `--dot-color: ${meta.color};`}
                    data-active={active ? "true" : "false"}
                  >
                    <span class="dot" />
                    {item.data.title}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ) : null
    )
  }
</nav>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: var(--space-5) var(--space-4);
    min-width: 220px;
  }

  .group-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: var(--space-3);
  }

  ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    transition: color var(--transition-fast), background var(--transition-fast);
  }

  .link:hover {
    color: var(--color-text);
    background: var(--color-surface);
  }

  .link[data-active="true"] {
    color: var(--color-text);
    background: var(--color-surface-secondary);
    font-weight: 500;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--dot-color);
    box-shadow: 0 0 0 transparent;
    flex-shrink: 0;
  }

  .link[data-active="true"] .dot {
    box-shadow: 0 0 8px var(--dot-glow, transparent);
  }
</style>
