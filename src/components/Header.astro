---
import { withBase } from "../lib/url";

const currentPath = Astro.url.pathname.replace(/\/$/, "");
const faqHref = withBase("/faq");
const faqActive = currentPath === faqHref;
---

<header class="header">
  <a href={withBase("/")} class="brand">
    <span class="brand-mark">⌁</span>
    <span class="brand-text">TWITTER SYSTEM DESIGN</span>
  </a>
  <nav class="nav">
    <a href={faqHref} class="nav-link" aria-current={faqActive ? "page" : undefined} data-active={faqActive ? "true" : "false"}>
      Interview Prep
    </a>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-6);
    background: rgba(14, 20, 32, 0.85);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    color: var(--color-text);
  }

  .brand-mark {
    color: var(--color-accent-mint);
    font-size: var(--text-lg);
    text-shadow: 0 0 8px var(--glow-mint);
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    transition: color var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--color-text);
    border-color: var(--color-accent-mint);
  }

  .nav-link[data-active="true"] {
    color: var(--color-text);
    border-color: var(--color-accent-mint);
    box-shadow: 0 0 10px var(--glow-mint);
  }
</style>
