{
  "basic": {
    "nodes": [
      {
        "id": "action",
        "label": "User Action",
        "x": 110,
        "y": 60,
        "description": "A like, reply, or follow occurs."
      },
      {
        "id": "api",
        "label": "API",
        "x": 330,
        "y": 60,
        "description": "Handles the action and writes the notification inline."
      },
      {
        "id": "row",
        "label": "Notification Row",
        "x": 550,
        "y": 60,
        "description": "Directly written as part of the request."
      },
      {
        "id": "client",
        "label": "Client",
        "x": 330,
        "y": 170,
        "description": "Periodically polls for new notifications."
      }
    ],
    "edges": [
      {
        "from": "action",
        "to": "api"
      },
      {
        "from": "api",
        "to": "row"
      },
      {
        "from": "client",
        "to": "row"
      }
    ]
  },
  "scaled": {
    "nodes": [
      {
        "id": "action",
        "label": "User Action",
        "x": 110,
        "y": 110,
        "description": "Publishes an event instead of writing inline."
      },
      {
        "id": "queue",
        "label": "Queue",
        "x": 330,
        "y": 110,
        "description": "Kafka — decouples the action from notification delivery."
      },
      {
        "id": "service",
        "label": "Notification Service",
        "x": 550,
        "y": 55,
        "description": "Consumes events and creates notification records."
      },
      {
        "id": "push",
        "label": "Push Channel",
        "x": 550,
        "y": 165,
        "description": "WebSocket for active users, FCM/APNs for offline ones."
      }
    ],
    "edges": [
      {
        "from": "action",
        "to": "queue"
      },
      {
        "from": "queue",
        "to": "service"
      },
      {
        "from": "service",
        "to": "push"
      }
    ]
  },
  "advanced": {
    "nodes": [
      {
        "id": "queue",
        "label": "Queue",
        "x": 110,
        "y": 110,
        "description": "Incoming events from any action-producing service."
      },
      {
        "id": "aggregate",
        "label": "Aggregation Window",
        "x": 330,
        "y": 110,
        "description": "Groups related events, e.g. 'Alice, Bob + 40 others liked your tweet.'"
      },
      {
        "id": "service",
        "label": "Notification Service",
        "x": 550,
        "y": 110,
        "description": "Creates the (now grouped) notification record."
      },
      {
        "id": "prefs",
        "label": "Preference Filter",
        "x": 770,
        "y": 55,
        "description": "Applies mute/priority settings before delivery."
      },
      {
        "id": "push",
        "label": "Push Channel",
        "x": 770,
        "y": 165,
        "description": "Final real-time or push delivery."
      }
    ],
    "edges": [
      {
        "from": "queue",
        "to": "aggregate"
      },
      {
        "from": "aggregate",
        "to": "service"
      },
      {
        "from": "service",
        "to": "prefs"
      },
      {
        "from": "prefs",
        "to": "push"
      }
    ]
  }
}
